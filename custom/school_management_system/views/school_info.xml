<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_school_info_form" model="ir.ui.view">
            <field name="name">school.info.form</field>
            <field name="model">school.info</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="title"/>
                                <h1>
                                    <field name="name" placeholder="First Name" />
                                    <field name="last_name" placeholder="Last Name" />
                                </h1>
                        <group>
                            
                            <group>
                                

                                <field name="age" />
                                <field name="student_class" />
                                <field name="dob" />
                            </group>
                            <group>
                                <field name="gender" />
                                <field name="percentage" />
                            </group>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_school_info_list" model="ir.ui.view">
            <field name="name">school.info.list</field>
            <field name="model">school.info</field>
            <field name="arch" type="xml">
                <list>

                    <field name="name" />
                    <field name="age" />
                    <field name="student_class" />
                    <field name="dob" />
                    <field name="gender" />
                    <field name="percentage" />

                </list>
            </field>
        </record>

        <record id="action_school_info" model="ir.actions.act_window">
            <field name="name">School Info</field>
            <field name="res_model">school.info</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new School Info
                </p>
            </field>
        </record>

        <menuitem id="school_main_menu" name="School Management System" />
        <menuitem id="school_info" name="School Info" parent="school_main_menu"
            action="action_school_info" />


    </data>
</odoo>