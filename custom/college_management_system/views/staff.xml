<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_staff_info_kanban" model="ir.ui.view">
        <field name="name">staff.info.kanban</field>
        <field name="model">staff.info</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <strong>
                            <field name="name" />
                            <field name="last_name"/> 
                        </strong>
                        <div class="rows"></div>
                        <div>
                            Age:<field  name="age" />
                        </div>
                        <field name="staff_department" />
                        <field name="dob" />
                        <field name="gender" />
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <data>
        <record id="view_staff_info_form" model="ir.ui.view">
            <field name="name">staff.info.form</field>
            <field name="model">staff.info</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="title" />
                        <h1>
                            <field name="name" placeholder="First Name" />
                            <field name="last_name" placeholder="Last Name" />
                        </h1>
                        <group>
                            <group>
                                <field name="age" />
                                <field name="staff_department" />
                                <field name="dob" />
                            </group>
                            <group>
                                <field name="gender" />
                                <field name="department_id"
                                    widget="many2many_checkbox"
                                    placeholder="Select department" />
                            </group>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_staff_info_list" model="ir.ui.view">
            <field name="name">staff.info.list</field>
            <field name="model">staff.info</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" />
                    <field name="last_name"/>
                    <field name="age" />
                    <field name="staff_department" />
                    <field name="dob" />
                    <field name="gender" />
                </list>
            </field>
        </record>
        <record id="action_staff_info" model="ir.actions.act_window">
            <field name="name">Staff Info</field>
            <field name="res_model">staff.info</field>
            <field name="view_mode">kanban,form,list</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a staff Info
                </p>
            </field>
        </record>
        <menuitem 
        id="staff_info"
        name="staff Info" 
        parent="main_menu"
        action="action_staff_info" />
    </data>
</odoo>