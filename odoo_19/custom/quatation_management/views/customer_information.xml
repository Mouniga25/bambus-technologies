<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_customer_information_kanban" model="ir.ui.view">
            <field name="name">customer.information.kanban</field>
            <field name="model">customer.information</field>
            <field name="arch" type="xml">
                <kanban>
                    <templates>
                        <t t-name="card">
                            <div>
                                <strong>
                                    <field name="customer_name" />
                                </strong>
                                <div> Order Date: <field name="order_date" />
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <record id="view_customer_information_form" model="ir.ui.view">
            <field name="name">customer.information.form</field>
            <field name="model">customer.information</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="customer_name" />
                                <field name="order_date" />
                            </group>

                            <notebook>
                                <page string="Order Lines">
                                    <field name="order_lines">
                                        <list editable="bottom">
                                            <field name="product" />
                                            <field name="quantity" />
                                            <field name="unit_price" />
                                            <field name="amount" />
                                        </list>
                                    </field>
                                </page>
                            </notebook>
                        </group>
                        <group>
                            <group>
                                
                            </group>
                            <group>
                                <field name="total" />
                            </group>
                        </group>

                    </sheet>

                </form>
            </field>
        </record>


        <record id="view_customer_information_list" model="ir.ui.view">
            <field name="name">customer.information.list</field>
            <field name="model">customer.information</field>
            <field name="arch" type="xml">
                <list>
                    <field name="customer_name" />
                    <field name="order_date" />
                </list>
            </field>
        </record>

        <record id="action_customer_information" model="ir.actions.act_window">
            <field name="name">Customer Information</field>
            <field name="res_model">customer.information</field>
            <field name="view_mode">kanban,list,form</field>
        </record>


        <menuitem id="order_information" name="Quotation" />

        <menuitem id="customer_information_menu"
            name="Customer Information"
            parent="order_information"
            action="action_customer_information" />

    </data>
</odoo>