<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- List View -->

    <record id="view_delivery_information_list" model="ir.ui.view">
        <field name="name">delivery.information.list</field>
        <field name="model">delivery.information</field>
        <field name="arch" type="xml">

            <list>
                <field name="name" />
                <field name="order_id" />
                <field name="customer_id" />
                <field name="delivery_date" />
                <field name="quantity" />
                <field name="vehicle_number" />
                <field
                    name="status"
                    widget="badge"
                    decoration-info="status == 'draft'"
                    decoration-primary="status == 'ready'"
                    decoration-warning="status == 'in_transit'"
                    decoration-success="status == 'delivered'"
                    decoration-danger="status == 'cancelled'"
                />
            </list>

        </field>
    </record>


    <!-- Form View -->

    <record id="view_delivery_information_form" model="ir.ui.view">
        <field name="name">delivery.information.form</field>
        <field name="model">delivery.information</field>
        <field name="arch" type="xml">

            <form>

                <header>

                    <button
                        name="action_mark_ready"
                        string="Ready"
                        type="object"
                        class="btn-primary"
                        invisible="status != 'draft'" />

                    <button
                        name="action_start_delivery"
                        string="Start Delivery"
                        type="object"
                        class="btn-primary"
                        invisible="status != 'ready'" />

                    <button
                        name="action_mark_delivered"
                        string="Mark Delivered"
                        type="object"
                        class="btn-primary"
                        invisible="status != 'in_transit'" />

                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        invisible="status in ('cancelled', 'delivered')" />

                    <button
                        name="action_reset_to_draft"
                        string="Reset to Draft"
                        type="object"
                        invisible="status != 'cancelled'" />

                    <field
                        name="status"
                        widget="statusbar"
                        statusbar_visible="draft,ready,in_transit,delivered" />

                </header>

                <sheet>

                    <group>

                        <group>
                            <field name="name" />
                            <field name="order_id" />
                            <field name="customer_id" readonly="1" />
                            <field name="company_id" readonly="1" />
                        </group>

                        <group>
                            <field name="delivery_date" />
                            <field name="quantity" />
                            <field name="vehicle_number" />
                        </group>

                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <!-- Action -->

    <record id="action_delivery_information"
        model="ir.actions.act_window">

        <field name="name">Deliveries</field>
        <field name="res_model">delivery.information</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Delivery Information
            </p>
        </field>

    </record>


    <!-- Menu -->

    <menuitem
        id="menu_delivery_information"
        name="Deliveries"
        parent="menu_village_pottery_root"
        action="action_delivery_information"
        sequence="80" />

</odoo>