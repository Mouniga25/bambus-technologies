<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- =========================================================
         LIST VIEW
    ========================================================== -->

    <record id="view_customer_order_information_list" model="ir.ui.view">

        <field name="name">customer.order.information.list</field>
        <field name="model">customer.order.information</field>

        <field name="arch" type="xml">

            <list>

                <field name="name" />
                <field name="customer_id" />
                <field name="order_date" />
                <field name="total_amount" />
                <field name="paid_amount" />
                <field name="balance_amount" />
                <field
                    name="status"
                    widget="badge"
                    decoration-info="status == 'draft'"
                    decoration-success="status == 'confirmed'"
                    decoration-primary="status == 'delivered'"
                    decoration-danger="status == 'cancelled'"
                />
                <field
                    name="payment_status"
                    widget="badge"
                    decoration-danger="payment_status == 'unpaid'"
                    decoration-warning="payment_status == 'partial'"
                    decoration-success="payment_status == 'paid'"
                />
                <field name="total_quantity" />

            </list>

        </field>

    </record>


    <!-- =========================================================
         FORM VIEW
    ========================================================== -->

    <record id="view_customer_order_information_form" model="ir.ui.view">

        <field name="name">customer.order.information.form</field>
        <field name="model">customer.order.information</field>

        <field name="arch" type="xml">

            <form>

                <!-- =================================================
                     HEADER / ACTION BUTTONS
                ================================================== -->

                <header>

                    <!-- ================= CONFIRM ================= -->

                    <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        class="btn-primary"
                        invisible="status != 'draft'"
                    />
                    <button
                        name="action_create_production"
                        string="Create Production"
                        type="object"
                        class="btn-primary"
                        invisible="status != 'confirmed'"
                    />


                    <!-- ================= DELIVER ================= -->

                    <button
                        name="action_mark_delivered"
                        string="Deliver"
                        type="object"
                        class="btn-success"
                        invisible="status != 'confirmed'"
                    />


                    <!-- ================= CANCEL ================= -->

                    <!--
                        Cancel is allowed only for:
                        Draft
                        Confirmed

                        Cancel is NOT allowed for:
                        Delivered
                        Cancelled
                    -->

                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        class="btn-danger"
                        invisible="status in ('delivered', 'cancelled')"
                    />


                    <!-- ================= RESET ================= -->

                    <!--
                        Only cancelled orders can be
                        moved back to Draft.
                    -->

                    <button
                        name="action_reset_to_draft"
                        string="Reset to Draft"
                        type="object"
                        invisible="status != 'cancelled'"
                    />


                    <!-- ================= STATUS ================= -->

                    <field
                        name="status"
                        widget="statusbar"
                        statusbar_visible="draft,confirmed,delivered,cancelled"
                    />

                </header>


                <!-- =================================================
                     FORM BODY
                ================================================== -->

                <sheet>
                    <div class="oe_button_box" name="button_box">

                        <button
                            name="action_view_deliveries"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-truck"
                        >
                            <field
                                name="delivery_count"
                                widget="statinfo"
                                string="Deliveries"
                            />
                        </button>
                        <button
                            name="action_view_productions"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-industry"
                        >
                            <field
                                name="production_count"
                                widget="statinfo"
                                string="Productions"
                            />
                        </button>

                    </div>


                    <!-- ================= ORDER REFERENCE ================= -->

                    <div class="oe_title">

                        <h1>

                            <field
                                name="name"
                                readonly="1"
                            />

                        </h1>

                    </div>


                    <!-- ================= ORDER INFORMATION ================= -->
                    <group>
                        <group>
                            <field name="customer_id" />
                            <field name="order_date" />
                        </group>
                        <group>
                            <field name="total_amount" readonly="1" />
                            <field name="paid_amount" />
                            <field name="balance_amount" readonly="1" />
                            <field name="total_quantity" />
                            <field name="payment_method" />
                            <field
                                name="payment_status"
                                widget="badge"
                                decoration-danger="payment_status == 'unpaid'"
                                decoration-warning="payment_status == 'partial'"
                                decoration-success="payment_status == 'paid'"
                            />
                        </group>
                    </group>


                    <!-- =================================================
                         ORDER LINES
                    ================================================== -->

                    <notebook>
                        <page string="Order Lines">
                            <field name="order_line_lines">
                                <list editable="bottom">
                                    <field name="product_id" />
                                    <field name="quantity" />
                                    <field name="unit_price" />
                                    <field name="subtotal" readonly="1" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <!-- =========================================================
         CUSTOMER ORDER ACTION
    ========================================================== -->

    <record id="action_customer_order_information" model="ir.actions.act_window">
        <field name="name">Customer Orders</field>
        <field name="res_model">customer.order.information</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Customer Order
            </p>
        </field>
    </record>


    <!-- =========================================================
         CUSTOMER ORDER MENU
    ========================================================== -->

    <menuitem
        id="menu_customer_order_information"
        name="Customer Orders"
        parent="menu_village_pottery_root"
        action="action_customer_order_information"
        sequence="70"
    />

</odoo>