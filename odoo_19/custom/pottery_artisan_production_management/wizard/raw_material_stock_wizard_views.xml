<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_raw_material_stock_wizard_form" model="ir.ui.view">
        <field name="name">raw.material.stock.wizard.form</field>
        <field name="model">raw.material.stock.wizard</field>
        <field name="arch" type="xml">

            <form string="Stock Adjustment">

                <group>

                    <field name="raw_material_id"/>
                    <field name="current_quantity"/>
                    <field name="adjustment_quantity"/>
                    <field name="reason"/>

                </group>

                <footer>

                    <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        class="btn-primary"
                    />

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />

                </footer>

            </form>

        </field>
    </record>

</odoo>