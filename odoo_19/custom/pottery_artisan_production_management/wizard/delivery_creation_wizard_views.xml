<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_delivery_creation_wizard_form" model="ir.ui.view">
        <field name="name">delivery.creation.wizard.form</field>
        <field name="model">delivery.creation.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Delivery">

                <group>

                    <group>

                        <field name="production_id"/>
                        <field name="order_id"/>
                        <field name="customer_id"/>

                    </group>

                    <group>

                        <field name="quantity"/>
                        <field name="delivery_date"/>
                        <field name="vehicle_number"/>

                    </group>

                </group>

                <footer>

                    <button
                        name="action_create_delivery"
                        string="Create Delivery"
                        type="object"
                        class="btn-primary"/>

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>

</odoo>