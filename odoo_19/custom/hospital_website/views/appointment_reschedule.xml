<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <template
        id="appointment_reschedule"
        name="Appointment Reschedule"
    >

        <t t-call="website.layout">

            <div class="container my-5">

                <div class="row justify-content-center">

                    <div class="col-lg-7">

                        <div class="card shadow">

                            <div class="card-body p-5">

                                <h2 class="text-center mb-3">
                                    Next Follow-up
                                </h2>

                                <p class="text-center text-muted mb-4">
                                    Please select a new appointment date.
                                </p>

                                <t t-if="error">

                                    <div class="alert alert-danger">
                                        <span t-out="error"/>
                                    </div>

                                </t>

                                <div class="mb-3">
                                    <strong>Patient:</strong>
                                    <span t-out="visit.patient_id.name"/>
                                </div>

                                <div class="mb-3">
                                    <strong>Doctor:</strong>
                                    <span t-out="visit.doctor_id.doctor_name"/>
                                </div>

                                <div class="mb-3">
                                    <strong>Current Appointment:</strong>
                                    <span t-out="visit.visit_date"/>
                                </div>

                                <hr/>

                                <form
                                    t-att-action="'/hospital/appointment/reschedule/submit/' + token"
                                    method="post"
                                >

                                    <input
                                        type="hidden"
                                        name="csrf_token"
                                        t-att-value="request.csrf_token()"
                                    />

                                    <div class="mb-4">

                                        <label
                                            for="appointment_date"
                                            class="form-label"
                                        >
                                            Next Appointment Date
                                        </label>

                                        <input
                                            type="datetime-local"
                                            id="appointment_date"
                                            name="appointment_date"
                                            class="form-control"
                                            required="required"
                                        />

                                    </div>

                                    <div class="text-center">

                                        <button
                                            type="submit"
                                            class="btn btn-primary btn-lg px-5"
                                        >
                                            Schedule Next Follow-up
                                        </button>

                                    </div>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </t>

    </template>

</odoo>