<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Module Category -->
    <record id="module_category_dmart" model="ir.module.category">
        <field name="name">D-Mart</field>
        <field name="sequence">1</field>
    </record>


    <!-- Privilege -->
    <record id="res_groups_privilege_dmart" model="res.groups.privilege">
        <field name="name">D-Mart</field>
        <field name="category_id" ref="module_category_dmart"/>
        <field name="sequence">7</field>
    </record>


    <!-- Admin -->
    <record id="group_admin" model="res.groups">
        <field name="name">Dmart Admin</field>
        <field name="privilege_id" ref="res_groups_privilege_dmart"/>
    </record>


    <!-- Manager -->
    <record id="group_manager" model="res.groups">
        <field name="name">Dmart Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_dmart"/>
    </record>


    <!-- Employee -->
    <record id="group_employee" model="res.groups">
        <field name="name">Dmart Employee</field>
        <field name="privilege_id" ref="res_groups_privilege_dmart"/>
    </record>

</odoo>