<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="billing_employee_rule" model="ir.rule">
        <field name="name">Employee Own Bills</field>
        <field name="model_id" ref="model_bill_counter"/>
        <field name="groups" eval="[(4, ref('dmart_management_system.group_employee'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>


    <record id="billing_manager_rule" model="ir.rule">
        <field name="name">Manager Bills</field>
        <field name="model_id" ref="model_bill_counter"/>
        <field name="groups" eval="[(4, ref('dmart_management_system.group_manager'))]"/>
        <field name="domain_force">[('user_id.manager_id', '=', user.id)]</field>
    </record>


    <record id="billing_admin_rule" model="ir.rule">
        <field name="name">Admin All Bills</field>
        <field name="model_id" ref="model_bill_counter"/>
        <field name="groups" eval="[(4, ref('dmart_management_system.group_admin'))]"/>
        <field name="domain_force">[(1,'=',1)]</field>
    </record>





</odoo>
