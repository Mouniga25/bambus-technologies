<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- form -->
    <record id="view_bill_counter_form" model="ir.ui.view">
      <field name="name">bill.counter.form</field>
      <field name="model">bill.counter</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <div class="title" />
            <group>
              <group>
                
                <field name="counter_code" />
                <field name="customer_name" />
                <field name="employee_name" />
                <field name="location" />
                <field name="opening_time" />
                <field name="closing_time" />
                <field name="total_kg" />
                <field name="total_number" />
                <field name="user_id" readonly="1" />

              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- list -->
    <record id="view_bill_counter_list" model="ir.ui.view">
      <field name="name">bill.counter.list</field>
      <field name="model">bill.counter</field>
      <field name="arch" type="xml">
        <list>
          <field name="counter_code" />
          <field name="customer_name" />
          <field name="employee_name" />
          <field name="location" />
          <field name="opening_time" />
          <field name="closing_time" />
          <field name="total_kg" />
          <field name="total_number" />
        </list>
      </field>
    </record>

    <record id="action_bill_counter" model="ir.actions.act_window">
      <field name="name">Bill Counter</field>
      <field name="res_model">bill.counter</field>
      <field name="view_mode">list,form</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Create a Bill Counter
        </p>
      </field>
    </record>

    <menuitem id="bill_counter" name="Bill Counter" action="action_bill_counter" />
  </data>
</odoo>