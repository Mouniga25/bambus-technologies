<odoo>

    <record id="crm_lead_form_inherit_discount" model="ir.ui.view">
        <field name="name">crm.lead.form.discount</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">


            <xpath expr="//group[@name='lead_priority']/field[@name='tag_ids']" position="after">
                <field name="crm_discount" />
            </xpath>

            <xpath expr="(//field[@name='tag_ids'])[1]" position="after">
                <field name="crm_discount" />
            </xpath>
        </field>
    </record>

</odoo>
