<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Graph View -->
    <record id="fleet_vehicle_lifecycle_graph_view" model="ir.ui.view">
        <field name="name">fleet.vehicle.lifecycle.graph</field>
        <field name="model">fleet.vehicle</field>
        <field name="arch" type="xml">
            <graph string="Fleet Lifecycle Dashboard" type="pie">
                <field name="lifecycle_status"/>
            </graph>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="fleet_vehicle_lifecycle_pivot_view" model="ir.ui.view">
        <field name="name">fleet.vehicle.lifecycle.pivot</field>
        <field name="model">fleet.vehicle</field>
        <field name="arch" type="xml">
            <pivot string="Fleet Lifecycle Analysis">
                <field name="category_id" type="row"/>
                <field name="lifecycle_status" type="col"/>
                <field name="lifetime_service_cost" type="measure"/>
                <field name="current_year_service_cost" type="measure"/>
                <field name="major_repair_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Existing Fleet Action -->
    <record id="fleet.fleet_vehicle_action" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form,activity,graph,pivot</field>
    </record>

    <!-- List View First -->
    <record id="fleet_vehicle_action_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="fleet.fleet_vehicle_view_tree"/>
        <field name="act_window_id" ref="fleet.fleet_vehicle_action"/>
    </record>

    <!-- Graph View -->
    <record id="fleet_vehicle_action_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="90"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="fleet_vehicle_lifecycle_graph_view"/>
        <field name="act_window_id" ref="fleet.fleet_vehicle_action"/>
    </record>

    <!-- Pivot View -->
    <record id="fleet_vehicle_action_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="91"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="fleet_vehicle_lifecycle_pivot_view"/>
        <field name="act_window_id" ref="fleet.fleet_vehicle_action"/>
    </record>

</odoo>