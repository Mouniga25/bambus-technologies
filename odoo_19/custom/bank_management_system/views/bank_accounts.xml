<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- bank account kanban -->
        <record id="view_bank_account_kanban" model="ir.ui.view">
            <field name="name">bank.accounts.kanban</field>
            <field name="model">bank.accounts</field>
            <field name="arch" type="xml">

                <kanban>
                    <templates>
                        <t t-name="card">

                            <strong>
                                Account Number:
                                <field name="account_number"/>
                            </strong>

                            <div class="rows">

                                <div>
                                    Customer:
                                    <field name="customer_id"/>
                                </div>

                                <div>
                                    Account Type:
                                    <field name="account_type_id"/>
                                </div>

                                <div>
                                    Home Branch:
                                    <field name="home_branch_id"/>
                                </div>

                                <div>
                                    Opening Date:
                                    <field name="opening_date"/>
                                </div>

                                <div>
                                    Account Status:
                                    <field name="account_status"/>
                                </div>

                                <div>
                                    Current Balance:
                                    <field name="current_balance"/>
                                </div>

                                <div>
                                    Handled By:
                                    <field name="employee_id"/>
                                </div>

                            </div>

                        </t>
                    </templates>
                </kanban>

            </field>
        </record>


        <!-- bank account form -->
        <record id="view_bank_account_form" model="ir.ui.view">
            <field name="name">bank.accounts.form</field>
            <field name="model">bank.accounts</field>
            <field name="arch" type="xml">

                <form>
                    <sheet>

                        <div class="title"/>

                        <h1>
                            <field name="account_number"
                                   placeholder="Account Number"/>
                        </h1>

                        <group>

                            <group>
                                <field name="customer_id"
                                       placeholder="Customer Name"/>

                                <field name="employee_id"
                                       placeholder="Handled By"/>

                                <field name="account_type_id"
                                       placeholder="Account Type"/>

                                <field name="home_branch_id"
                                       placeholder="Home Branch"/>

                                <field name="opening_date"
                                       placeholder="Opening Date"/>

                                <field name="account_status"
                                       placeholder="Account Status"/>

                                <field name="current_balance"
                                       readonly="1"/>

                            </group>

                        </group>


                        <!-- transaction history -->
                        <notebook>

                            <page string="transaction history">

                                <field name="transaction_line">

                                    <list editable="bottom">

                                        <field name="transaction_date"/>

                                        <field name="transaction_type"/>

                                        <field name="reference"/>

                                        <field name="amount"/>

                                        <field name="employee_id"/>

                                    </list>

                                </field>

                            </page>

                        </notebook>

                    </sheet>
                </form>

            </field>
        </record>


        <!-- bank account list -->
        <record id="view_bank_account_list" model="ir.ui.view">
            <field name="name">bank.accounts.list</field>
            <field name="model">bank.accounts</field>
            <field name="arch" type="xml">

                <list>

                    <field name="account_number"/>

                    <field name="customer_id"/>

                    <field name="employee_id"/>

                    <field name="account_type_id"/>

                    <field name="home_branch_id"/>

                    <field name="opening_date"/>

                    <field name="account_status"/>

                    <field name="current_balance"/>

                </list>

            </field>
        </record>


        <!-- bank account search -->
        <record id="view_bank_account_search" model="ir.ui.view">
            <field name="name">bank.accounts.search</field>
            <field name="model">bank.accounts</field>
            <field name="arch" type="xml">

                <search>

                    <!-- search -->
                    <field name="account_number"/>

                    <field name="customer_id"/>

                    <field name="employee_id"/>

                    <!-- account status filters -->
                    <filter
                        name="filter_active"
                        string="active"
                        domain="[('account_status', '=', 'active')]"/>

                    <filter
                        name="filter_dormant"
                        string="dormant"
                        domain="[('account_status', '=', 'dormant')]"/>

                    <filter
                        name="filter_closed"
                        string="closed"
                        domain="[('account_status', '=', 'closed')]"/>

                    <!-- group by -->
                    <filter
                        name="group_by_account_type"
                        string="account type"
                        context="{'group_by': 'account_type_id'}"/>

                    <filter
                        name="group_by_home_branch"
                        string="home branch"
                        context="{'group_by': 'home_branch_id'}"/>

                    <filter
                        name="group_by_employee"
                        string="handled by"
                        context="{'group_by': 'employee_id'}"/>

                </search>

            </field>
        </record>


        <!-- bank account action -->
        <record id="action_bank_account" model="ir.actions.act_window">

            <field name="name">bank accounts</field>

            <field name="res_model">bank.accounts</field>

            <field name="view_mode">kanban,form,list</field>

            <field name="search_view_id"
                   ref="view_bank_account_search"/>

            <field name="help" type="html">

                <p class="o_view_nocontent_smiling_face">
                    create a bank account
                </p>

            </field>

        </record>


        <!-- operations menu -->
        <menuitem
            id="operations_information"
            name="operations"
            parent="bank_information"/>


        <!-- bank account menu -->
        <menuitem
            id="bank_account"
            name="bank accounts"
            parent="operations_information"
            action="action_bank_account"/>

    </data>
</odoo>