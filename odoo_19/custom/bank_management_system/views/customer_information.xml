<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- kanban -->
        <record id="view_customer_information_kanban" model="ir.ui.view">
            <field name="name">customer.information.kanban</field>
            <field name="model">customer.information</field>
            <field name="arch" type="xml">
                <kanban>
                    <templates>
                        <t t-name="card">

                            <div>
                                <field name="photo"
                                       widget="image"
                                       class="oe_kanban_image"/>
                            </div>

                            <strong>
                                <div>
                                    Name:
                                    <field name="name"/>
                                    <field name="last_name"/>
                                </div>
                            </strong>

                            <div class="rows">

                                <div>
                                    KYC Status:
                                    <field name="kyc_status"/>
                                </div>

                                <div>
                                    DOB:
                                    <field name="date_of_birth"/>
                                </div>

                                <div>
                                    Age:
                                    <field name="age"/>
                                </div>

                                <div>
                                    Gender:
                                    <field name="gender"/>
                                </div>

                                <div>
                                    Branch:
                                    <field name="home_branch_id"/>
                                </div>

                            </div>

                        </t>
                    </templates>
                </kanban>
            </field>
        </record>


        <!-- form -->
        <record id="view_customer_information_form" model="ir.ui.view">
            <field name="name">customer.information.form</field>
            <field name="model">customer.information</field>
            <field name="arch" type="xml">

                <form>
                    <sheet>

                        <field name="photo"
                               widget="image"
                               class="oe_avatar"/>

                        <div class="title"/>

                        <h1>
                            <field name="name"
                                   placeholder="First Name"/>
                            <field name="last_name"
                                   placeholder="Last Name"/>
                        </h1>

                        <group>

                            <group>
                                <field name="kyc_status"/>
                                <field name="date_of_birth"/>
                                <field name="age"/>
                                <field name="gender"/>
                                <field name="home_branch_id"/>
                            </group>

                        </group>

                        <notebook>

                            <!-- customer accounts -->
                            <page string="Customer Accounts">

                                <field name="customer_accounts_lines">

                                    <list editable="bottom">

                                        <field name="account_number"/>
                                        <field name="account_type_id"/>
                                        <field name="current_balance"/>
                                        <field name="account_status"/>

                                    </list>

                                </field>

                            </page>


                            <!-- nominee details -->
                            <page string="Nominee Details">

                                <field name="nominee_details_lines">

                                    <list editable="bottom">

                                        <field name="nominee_name"/>
                                        <field name="relationship"/>
                                        <field name="share_percentage"/>
                                        <field name="phone"/>

                                    </list>

                                </field>

                            </page>


                            <!-- contact information -->
                            <page string="Contact Information">

                                <group>

                                    <field name="address"/>
                                    <field name="phone"/>
                                    <field name="alternate_phone"/>

                                </group>

                            </page>

                        </notebook>

                    </sheet>
                </form>

            </field>
        </record>


        <!-- list -->
        <record id="view_customer_information_list" model="ir.ui.view">
            <field name="name">customer.information.list</field>
            <field name="model">customer.information</field>
            <field name="arch" type="xml">

                <list>

                    <field name="name"/>
                    <field name="last_name"/>
                    <field name="kyc_status"/>
                    <field name="date_of_birth"/>
                    <field name="age"/>
                    <field name="gender"/>
                    <field name="home_branch_id"/>
                    <field name="phone"/>

                </list>

            </field>
        </record>


        <!-- search -->
        <record id="view_customer_information_search" model="ir.ui.view">
            <field name="name">customer.information.search</field>
            <field name="model">customer.information</field>
            <field name="arch" type="xml">

                <search>

                    <!-- search by name -->
                    <field name="name"/>

                    <!-- search by phone -->
                    <field name="phone"/>

                    <!-- kyc filters -->
                    <filter
                        name="filter_kyc_pending"
                        string="pending"
                        domain="[('kyc_status', '=', 'pending')]"/>

                    <filter
                        name="filter_kyc_verified"
                        string="verified"
                        domain="[('kyc_status', '=', 'verified')]"/>

                    <filter
                        name="filter_kyc_rejected"
                        string="rejected"
                        domain="[('kyc_status', '=', 'rejected')]"/>

                    <!-- group by home branch -->
                    <filter
                        name="group_by_home_branch"
                        string="home branch"
                        context="{'group_by': 'home_branch_id'}"/>

                </search>

            </field>
        </record>


        <!-- action -->
        <record id="action_customer_information"
                model="ir.actions.act_window">

            <field name="name">customer information</field>
            <field name="res_model">customer.information</field>

            <field name="view_mode">kanban,form,list</field>

            <field name="search_view_id"
                   ref="view_customer_information_search"/>

            <field name="help" type="html">

                <p class="o_view_nocontent_smiling_face">
                    create a customer information
                </p>

            </field>

        </record>


        <!-- bank menu -->
        <menuitem
            id="bank_information"
            name="bank"/>


        <!-- customer menu -->
        <menuitem
            id="customer_information"
            name="customers"
            parent="bank_information"
            action="action_customer_information"/>

    </data>
</odoo>