<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_account_type_kanban" model="ir.ui.view">
            <field name="name">account.type.kanban</field>
            <field name="model">account.type</field>
            <field name="arch" type="xml">
                <kanban>
                    <templates>
                        <t t-name="card">
                            <strong> Type Name: <field name="type_name" />
                            </strong>
                            <div
                                class="rows"></div>
                            <div>Type Code: <field name="type_code" />
                            </div>
                            <div> Interest Rate: <field name="interest_rate" /></div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>


        <!-- form -->
        <record id="view_account_type_form" model="ir.ui.view">
            <field name="name">account.type.form</field>
            <field name="model">account.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="title" />
                        <h1>
                            <field name="type_name" placeholder="Type Name" />

                        </h1>
                        <group>
                            <group>

                                <field name="type_code" placeholder="Type Code" />
                                <field name="interest_rate" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_account_type_list" model="ir.ui.view">
            <field name="name">account.type.list</field>
            <field name="model">account.type</field>
            <field name="arch" type="xml">
                <list>

                    <field name="type_name" />
                    <field name="type_code" />
                    <field name="interest_rate" />

                </list>
            </field>
        </record>
        <record id="action_account_type" model="ir.actions.act_window">
            <field name="name">Account Types</field>
            <field name="res_model">account.type</field>
            <field name="view_mode">kanban,form,list</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create Account Type
                </p>
            </field>
        </record>
      
        <menuitem
            id="account_type"
            name="Account Type"
            parent="Configurations_information"
            action="action_account_type" />
    </data>
</odoo>