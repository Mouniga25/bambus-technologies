<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_hospital" model="ir.module.category">
            <field name="name">Hospital</field>
            <field name="sequence">10</field>
        </record>
        
        <record id="group_doctor" model="res.groups">
            <field name="name">Doctor</field>

        </record>
        <record id="group_receptionist" model="res.groups">
            <field name="name">Receptionist</field>
        </record>

        <record id="group_lab_technician" model="res.groups">
            <field name="name">Lab Technician</field>
        </record>

        <record id="group_manager" model="res.groups">
            <field name="name">Manager</field>
        </record>

        <record id="doctor_visit_rule" model="ir.rule">

            <field name="name">
                Doctor Own Visit
            </field>

            <field name="model_id" ref="model_hospital_patient_visit" />

            <field name="domain_force">
                [('doctor_id.user_id','=',user.id)]
            </field>
            <field name="groups"
                eval="[(4, ref('hospital_core_api.group_doctor'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />

        </record>

        <record id="doctor_patient_visit_rule" model="ir.rule">

            <field name="name">Doctor Own Patient Visits</field>

            <field name="model_id" ref="model_hospital_patient_visit" />

            <field name="domain_force">
                [('doctor_id.user_id', '=', user.id)]
            </field>

            <field name="groups"
                eval="[(4, ref('hospital_core_api.group_doctor'))]" />

        </record>
    </data>
</odoo>