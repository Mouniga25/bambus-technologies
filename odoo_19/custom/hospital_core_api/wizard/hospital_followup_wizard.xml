<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_followup_wizard_form" model="ir.ui.view">
        <field name="name">hospital.followup.wizard.form</field>
        <field name="model">hospital.followup.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="patient_id" />
                        <field name="doctor_id" />
                    </group>
                    <group>
                        <field name="appointment_date" />
                        <field name="notes" required='1'/>
                    </group>
                </group>
                <footer>
                    <button
                        name="action_schedule"
                        type="object"
                        string="Schedule"
                        class="btn-primary"
                    />

                    <button
                        string="Cancel"
                        special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_hospital_followup_wizard" model="ir.actions.act_window">
        <field name="name">Hospital Followup Wizard</field>
        <field name="res_model">hospital.followup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>