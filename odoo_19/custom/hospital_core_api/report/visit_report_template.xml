<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <template id="report_visit_summary">
        <t t-call="web.external_layout">
            <t t-foreach="docs" t-as="doc">
                <main class="page">

                    <table style="width:100%;background:#A076E5;color:white;">
                        <tr>
                          <td style="padding:15px;">
                                <h2 style="color:white;">Visiting Report</h2>
                            </td>

                          <td style="text-align:right;padding:15px;">
                                <strong>Visit No:</strong>
                                <span t-esc="doc.visit_number" />
                            </td>
                        </tr>
                    </table>

                    <br />

                    <table width="100%" border="1"
                        style="border-collapse:collapse;">

                        <tr style="background:#A076E5;color:white;">
                            <th colspan="2">Patient Information</th>
                        </tr>

                        <tr>
                          <td style="padding:4px;">Patient Name</td>
                          <td style="padding:4px;">
                                <span t-esc="doc.patient_id.patient_name or doc.patient_id.name" />
                            </td>
                        </tr>

                        <tr>
                          <td style="padding:4px;">Patient ID</td>
                          <td style="padding:4px;">
                                <span t-esc="doc.patient_id.patient_id" />
                            </td>
                        </tr>

                        <tr>
                          <td style="padding:4px;">Date of Birth</td>
                          <td style="padding:4px;">
                                <span t-esc="doc.patient_id.date_of_birth" />
                            </td>
                        </tr>

                        <tr>
                          <td style="padding:4px;">Age</td>
                          <td style="padding:4px;">
                                <span t-esc="doc.patient_id.age" />
                            </td>
                        </tr>

                        <tr>
                          <td style="padding:4px;">Gender</td>
                          <td style="padding:4px;">
                                <span t-esc="doc.patient_id.gender" />
                            </td>
                        </tr>

                        <tr>
                          <td style="padding:4px;">Blood Group</td>
                          <td style="padding:4px;">
                                <span t-esc="doc.patient_id.blood_group" />
                            </td>
                        </tr>

                        <tr>
                          <td style="padding:4px;">Doctor Name</td>
                          <td style="padding:4px;">
                                <span t-esc="doc.doctor_id.doctor_name" />
                            </td>
                        </tr>

                        <tr>
                          <td style="padding:4px;">Department</td>
                          <td style="padding:4px;">
                                <span t-esc="doc.department_id.department_name" />
                            </td>
                        </tr>

                        <tr>
                          <td style="padding:4px;">Visit Date</td>
                          <td style="padding:4px;">
                                <span t-field="doc.visit_date" />
                            </td>
                        </tr>

                    </table>

                    <br />

                    <table width="100%" border="1"
                        style="border-collapse:collapse;">

                        <tr style="background:#A076E5;color:white;">
                            <th colspan="2">Hospital Details</th>
                        </tr>

                        <tr>
                          <td style="padding:4px;">Symptoms</td>
                          <td style="padding:4px;">
                                <span t-esc="doc.symptoms" />
                            </td>
                        </tr>

                        <tr>
                          <td style="padding:4px;">Diagnosis</td>
                          <td style="padding:4px;">
                                <span t-esc="doc.diagnosis_id.name" />
                            </td>
                        </tr>

                        <tr>
                          <td style="padding:4px;">Doctor Notes</td>
                          <td style="padding:4px;">
                                <span t-esc="doc.notes" />
                            </td>
                        </tr>

                        <tr>
                          <td style="padding:4px;">Status</td>
                          <td style="padding:4px;">
                                <span t-esc="doc.state" />
                            </td>
                        </tr>

                    </table>

                    <br />

                    <!-- Instruction Left + QR Right -->
                    <div style="border-top:2px solid #A076E5;padding-top:10px;">

                        <table width="100%" style="border-collapse:collapse;">

                            <tr>

                                <!-- Left Side Instruction -->
                              <td 
                                    style="width:60%;
           vertical-align:top;
           border:1px solid #000000;
           padding:10px;">

                                    <strong>Hospital Notes:</strong>

                                    <p>
                                        Please follow the doctor instruction
                                        and take the medicines.
                                    </p>

                                </td>


                                <!-- Right Side QR Code -->
                              <td 
                                    style="width:40%;
           text-align:right;
           border:1px solid #000000;
           padding:10px;">

                                    <img t-if="doc.qr_code"
                                        t-att-src="image_data_uri(doc.qr_code)"
                                        style="width:130px;height:130px;" />

                                    <br />

                                    <span style="font-size:12px;">
                                    Scan to verify report
                                    </span>

                                </td>

                            </tr>

                        </table>

                    </div>


                    <!-- Footer -->
                    <div
                        style="
                        margin-top:30px;
                        border-top:1px solid #A076E5;
                        padding-top:10px;
                        text-align:center;">

                        <strong>
                            Thank you for visiting ABC Hospital
                        </strong>

                        <br />

                        <span>
                            We care for your health
                        </span>

                    </div>


                </main>
            </t>
        </t>
    </template>
</odoo>