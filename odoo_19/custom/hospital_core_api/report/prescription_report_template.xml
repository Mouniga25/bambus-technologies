<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="report_prescription">
        <t t-call="web.external_layout">
            <t t-foreach="docs" t-as="doc">
                <main class="page">
                    <table style="width:100%;background:#A076E5;color:white;">
                        <tr>
                            <td style="padding:15px;">
                                <h2 style="color:white;">
                                    Prescription Report
                                </h2>
                            </td>

                            <td style="text-align:right;padding:15px;">
                                <strong>Prescription ID :</strong>
                                <span t-esc="doc.id"/>
                            </td>
                        </tr>
                    </table>
                    <br/>
                    <table style="width:100%;border-collapse:collapse;" border="1">

                        <tr style="background:#A076E5;color:white;">
                            <th colspan="2">
                                Prescription Information
                            </th>
                        </tr>
                        <tr>
                            <td><strong>Patient Name</strong></td>
                            <td><span t-esc="doc.patient_id.name"/></td>
                        </tr>
                        <tr>
                            <td><strong>Doctor Name</strong></td>
                            <td><span t-esc="doc.doctor_id.doctor_name"/></td>
                        </tr>
                        <tr>
                            <td><strong>Medicine Name</strong></td>
                            <td><span t-esc="doc.med_name"/></td>
                        </tr>
                        <tr>
                            <td><strong>Timing</strong></td>
                            <td><span t-esc="dict(doc._fields['timing'].selection).get(doc.timing)"/></td>
                        </tr>
                        <tr>
                            <td><strong>Description</strong></td>
                            <td><span t-esc="doc.description"/></td>
                        </tr>
                        <tr>
                            <td><strong>Notes</strong></td>
                            <td><span t-esc="doc.notes"/></td>
                        </tr>
                    </table>
                    <br/>
                    <div style="border-top:2px solid #A076E5;padding-top:10px;">
                        <strong>Doctor Notes:</strong>
                        <t t-if="doc.notes">
                            <p><span t-esc="doc.notes"/></p>
                        </t>
                        <t t-else="">
                            <p>Thank you for visiting ABC Hospital.</p>
                        </t>
                    </div>
                </main>
            </t>
        </t>
    </template>
</odoo>