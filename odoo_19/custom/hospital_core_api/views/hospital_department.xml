<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- form -->
        <record id="view_hospital_department_form" model="ir.ui.view">
            <field name="name">hospital.department.form</field>
            <field name="model">hospital.department</field>
            <field name="arch" type="xml">
                <form>

                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button type="object"
                                name="action_view_doctors"
                                class="oe_stat_button"
                                icon="fa-users">
                                <field name="doctor_lines" widget="statinfo" string="Doctor" />
                            </button>
                            <button type="object"
                                name="action_view_patient"
                                class="oe_stat_button">
                                <field name="patient_lines" widget="statinfo" string="Patient" />
                            </button>
                        </div>
                        <div class="title" />
                        <group>
                            <group>
                                <field name="department_name" />
                                <field name="department_code" />
                            </group>

                        </group>
                        <!-- <notebook>
                            <page string="Doctor Information">
                                <field name="doctor_lines"/> 
                                <list editable ="bottom">
                                    <field name ="doctor_name"/>
                                    <field name ="phone"/>
                                    <field name ="department_id"/>

                                </list> 
                            </page>
                        </notebook> -->
                    </sheet>
                </form>
            </field>
        </record>

        <!-- list -->
        <record id="view_hospital_department_list" model="ir.ui.view">
            <field name="name">hospital.department.list</field>
            <field name="model">hospital.department</field>
            <field name="arch" type="xml">
                <list>
                    <field name="department_name" />
                    <field name="department_code" />

                </list>
            </field>
        </record>
        <!-- search -->
        <record id="view_hospital_department_search" model="ir.ui.view">
            <field name="name">hospital.department.search</field>
            <field name="model">hospital.department</field>
            <field name="arch" type="xml">
                <search>
                    <field name="department_name" />
                </search>
            </field>
        </record>


        <record id="action_hospital_department" model="ir.actions.act_window">
            <field name="name">Hospital Department</field>
            <field name="res_model">hospital.department</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Hospital Department
                </p>
            </field>
        </record>
        <menuitem id="hospital_details" name="Hospital Details"
            parent="hospital_information"/>
            <!-- groups="hospital_core_api.group_manager,hospital_core_api.group_doctor"/> -->

        <menuitem id="hospital_department" name="Department"
            parent="hospital_details"
            action="action_hospital_department"/>
            <!-- groups="hospital_core_api.group_manager,hospital_core_api.group_doctor"/> -->

    </data>
</odoo>


