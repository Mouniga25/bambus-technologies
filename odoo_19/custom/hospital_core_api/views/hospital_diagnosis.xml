<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- form -->
        <record id="view_hospital_diagnosis_form" model="ir.ui.view">
            <field name="name">hospital.diagnosis.form</field>
            <field name="model">hospital.diagnosis</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="title" />
                        <group>
                            <group>
                                <field name="name" />
                                <field name="description" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- list -->
        <record id="view_hospital_diagnosis_list" model="ir.ui.view">
            <field name="name">hospital.diagnosis.list</field>
            <field name="model">hospital.diagnosis</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" />
                    <field name="description" />
                </list>
            </field>
        </record>
        <!-- search -->
        <record id="view_hospital_diagnosis_search" model="ir.ui.view">
            <field name="name">hospital.diagnosis.search</field>
            <field name="model">hospital.diagnosis</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />

                </search>
            </field>
        </record>


        <record id="action_hospital_diagnosis" model="ir.actions.act_window">
            <field name="name">Hospital Diagnosis</field>
            <field name="res_model">hospital.diagnosis</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Hospital Diagnosis
                </p>
            </field>
        </record>
        <menuitem id="hospital_diagnosis" name="Diagnosis"
            parent="hospital_details"
            action="action_hospital_diagnosis"/>
            <!-- groups="hospital_core_api.group_manager,hospital_core_api.group_doctor"/> -->

    </data>
</odoo>

 <!-- groups="hospital_core_api.group_manager,
                  hospital_core_api.group_doctor" -->