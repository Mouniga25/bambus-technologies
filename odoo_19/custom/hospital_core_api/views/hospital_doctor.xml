<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- form -->
        <record id="view_hospital_doctor_form" model="ir.ui.view">
            <field name="name">hospital.doctor.form</field>
            <field name="model">hospital.doctor</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_button_box" name="button_box">

                            <button name="action_view_patients"
                                type="object"
                                class="oe_stat_button">
                                <field name="patient_count"
                                    widget="statinfo"
                                    string="Assigned Patients" />
                            </button>


                            <button name="action_view_pending_lab_results"
                                type="object"
                                class="oe_stat_button">
                                <field name="pending_lab_count"
                                    widget="statinfo"
                                    string="Pending Lab Results" />
                            </button>

                        </div>

                        <div class="title" />
                        <group>
                            <group>
                                <field name="doctor_name" />
                                <field name="user_id" />
                                <field name="email" />
                                <field name="phone" />
                                <field name="description" />
                                <field name="department_id" />

                            </group>


                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- list -->
        <record id="view_hospital_doctor_list" model="ir.ui.view">
            <field name="name">hospital.doctor.list</field>
            <field name="model">hospital.doctor</field>
            <field name="arch" type="xml">
                <list>
                    <field name="doctor_name" />
                    <field name="email" />
                    <field name="phone" />
                    <field name="description" />
                    <field name="department_id" />
                </list>
            </field>
        </record>
        <!-- search -->
        <record id="view_hospital_doctor_search" model="ir.ui.view">
            <field name="name">hospital.doctor.search</field>
            <field name="model">hospital.doctor</field>
            <field name="arch" type="xml">
                <search>
                    <field name="doctor_name" />
                    <field name="department_id" />
                    <filter name="filter_department_id" string="Department"
                        context="{'group_by':'department_id'}" />
                </search>
            </field>
        </record>


        <record id="action_hospital_doctor" model="ir.actions.act_window">
            <field name="name">Hospital doctor</field>
            <field name="res_model">hospital.doctor</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Hospital doctor
                </p>
            </field>
        </record>

        <menuitem id="hospital_doctor" name="Doctor"
            parent="hospital_details"
            action="action_hospital_doctor"/>
            <!-- groups="hospital_core_api.group_manager,hospital_core_api.group_doctor"/> -->

    </data>
</odoo>

<!-- groups="hospital_core_api.group_manager,
                  hospital_core_api.group_doctor" -->