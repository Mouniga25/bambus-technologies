<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- form -->
        <record id="view_hospital_lab_test_form" model="ir.ui.view">
            <field name="name">hospital.lab.test.form</field>
            <field name="model">hospital.lab.test</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="title" />
                        <group>
                            <group>
                                <field name="patient_id" />
                                <field name="result" />
                                <field name="price" />
                                <field name="unit" />
                                <field name="reference_range" />
                                <field name="description" />
                                <field name="test_category" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- list -->
        <record id="view_hospital_lab_test_list" model="ir.ui.view">
            <field name="name">hospital.lab.test.list</field>
            <field name="model">hospital.lab.test</field>
            <field name="arch" type="xml">
                <list>

                    <field name="patient_id" />
                    <field name="result" />
                    <field name="price" />
                    <field name="unit" />
                    <field name="reference_range" />
                    <field name="description" />
                    <field name="test_category" />

                </list>
            </field>
        </record>
        <!-- search -->
        <record id="view_hospital_lab_test_search" model="ir.ui.view">
            <field name="name">hospital.lab.test.search</field>
            <field name="model">hospital.lab.test</field>
            <field name="arch" type="xml">
                <search>
                    <field name="test_category" />
                    <field name="patient_id" />

                    <filter name="filter_test_category" string="Test Category"
                        context="{'group_by':'test_category'}" />

                </search>
            </field>
        </record>
        <record id="action_hospital_lab_test" model="ir.actions.act_window">
            <field name="name">Hospital Lab Test</field>
            <field name="res_model">hospital.lab.test</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Hospital Lab Test
                </p>
            </field>
        </record>

        <menuitem id="hospital_lab_test" name="Lab Test"
            parent="hospital_Laboratory"
            action="action_hospital_lab_test"/>
            <!-- groups="hospital_core_api.group_manager,hospital_core_api.group_lab_technician" -->
             

    </data>
</odoo>


