<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- form -->
        <record id="view_hospital_prescription_form" model="ir.ui.view">
            <field name="name">hospital.prescription.form</field>
            <field name="model">hospital.prescription</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="title" />
                        <group>
                            <group>
                                <field name="patient_id" />
                                <field name="doctor_id" />
                                <field name="med_name" />
                                <field name="timing" />
                                <field name="description" />
                                <field name="notes" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- list -->
        <record id="view_hospital_prescription_list" model="ir.ui.view">
            <field name="name">hospital.prescription.list</field>
            <field name="model">hospital.prescription</field>
            <field name="arch" type="xml">
                <list>
                    <field name="patient_id" />
                    <field name="doctor_id" />
                    <field name="med_name" />
                    <field name="timing" />
                    <field name="description" />
                    <field name="notes" />

                </list>
            </field>
        </record>
        <!-- search -->
        <record id="view_hospital_prescription_search" model="ir.ui.view">
            <field name="name">hospital.prescription.search</field>
            <field name="model">hospital.prescription</field>
            <field name="arch" type="xml">
                <search>
                    <field name="patient_id" />
                    <field name="doctor_id" />
                </search>
            </field>
        </record>


        <record id="action_hospital_prescription" model="ir.actions.act_window">
            <field name="name">Hospital Prescription</field>
            <field name="res_model">hospital.prescription</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Hospital Prescription
                </p>
            </field>
        </record>

        <menuitem id="hospital_prescription" name="Prescription"
            parent="hospital_details"
            action="action_hospital_prescription"/>
            <!-- groups="hospital_core_api.group_manager,hospital_core_api.group_doctor"/> -->

    </data>
</odoo>

