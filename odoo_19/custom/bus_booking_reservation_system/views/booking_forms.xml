<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_booking_forms_kanban" model="ir.ui.view">
            <field name="name">booking.forms.kanban</field>
            <field name="model">booking.forms</field>
            <field name="arch" type="xml">
                <kanban>
                    <templates>
                        <t t-name="card">
                            <strong>
                                <div> Passenger Name : <field name="passenger_name" />
                                </div>
                            </strong>
                            <div
                                class="rows">
                                <div> Phone Number : <field name="phone_number" />
                                </div>
                                <div> E-mail : <field name="email" />
                                </div>

                                <div> From Place : <field name="from_place_id" />
                                </div>

                                <div> To Place : <field name="to_place_id" />
                                </div>
                                <div> Male Adults : <field name="adults_male" />
                                </div>
                                <div> Female Adults : <field name="adults_female" />
                                </div>
                                <div> Male Children : <field name="children_male" />
                                </div>
                                <div> Female Children : <field name="children_female" />
                                </div>
                                <div> Total Passengers : <field name="total_passengers" />
                                </div>
                                <div> Departure Date/Time : <field name="departure_date_time" />
                                </div>
                                <div> Arrival Date/Time : <field name="arrival_date_time" />
                                </div>
                                <div>Class of Service : <field name="classof_service_id" />
                                </div>
                                <div> Price Per Passenger : <field name="price_per_passenger" />
                                </div>
                                <div> Total Amount : <field name="total_amount" />
                                </div>
                                <!-- <div> Pickup Address : <field name="pickup_address_lines" />
                                </div>

                                <div>Destination Address : <field name="destination_address_lines" />
                                </div>  -->
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <!-- form -->
        <record id="view_booking_forms_form" model="ir.ui.view">
            <field name="name">booking.forms.form</field>
            <field name="model">booking.forms</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_draft" invisible="state in ['draft','booked']"
                            string="Draft" type="object" />
                        <button name="action_booked" invisible="state in ['booked', 'cancelled']"
                            string="Booked" type="object" />
                        <button name="action_cancelled" invisible="state == 'draft'"
                            string="Cancelled" type="object" />
                        <field name="state" widget="statusbar" />
                    </header>
                    <sheet>
                        <div class="title" />
                        <h1>
                            <field name="passenger_name" readonly="state == 'booked'" />
                        </h1>
                        <group>
                            <group>
                                <field name="phone_number" readonly="state == 'booked'" />
                                <field name="email" readonly="state == 'booked'" />
                                <field name="from_place_id" readonly="state == 'booked'" />
                                <field name="to_place_id" readonly="state == 'booked'" />
                                <field name="adults_male" />
                                <field name="adults_female" />
                                <field name="children_male" />
                                <field name="children_female" />
                                <field name="total_passengers" />
                            </group>
                            <group>
                                <field name="departure_date_time" readonly="state == 'booked'" />
                                <field name="arrival_date_time" readonly="state == 'booked'" />
                                <field name="classof_service_id" />
                                <field name="price_per_passenger" />
                                <field name="total_amount" />
                                <field name="pickup_address" readonly="state == 'booked'" />
                                <field name="destination_address" readonly="state == 'booked'" />
                                <field name="number_of_seat" />
                                <field name="available_seats" />   
                            </group>
                        </group>
                        <notebook>
                            <page string="Passenger Information">
                                <field name="passenger_information_lines">
                                    <list editable="bottom">
                                        <field name="name" />
                                        <field name="age" />
                                        <field name="gender" />
                                        <field name="passenger" />
                                        <field name="seat_preference" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- list -->
        <record id="view_booking_forms_list" model="ir.ui.view">
            <field name="name">booking.forms.list</field>
            <field name="model">booking.forms</field>
            <field name="arch" type="xml">
                <list decoration-success="state == 'booked'"
                    decoration-danger="state == 'cancelled'">

                    <field name="passenger_name" />
                    <field name="phone_number" />
                    <field name="from_place_id" />
                    <field name="to_place_id" />
                    <field name="departure_date_time" />
                    <field name="total_passengers" />
                    <field name="classof_service_id" />
                    <field name="pickup_address" />
                    <field name="destination_address" />
                    <field name="total_amount" />
                    <field name="state" />


                </list>
            </field>
        </record>


        <!-- search -->
        <record id="view_booking_forms_search" model="ir.ui.view">
            <field name="name">booking.forms.search</field>
            <field name="model">booking.forms</field>
            <field name="arch" type="xml">
                <search>
                    <field name="passenger_name" />
                    <field name="phone_number" />
                    <field name="from_place_id" />
                    <field name="to_place_id" />

                    <!-- filter -->
                    <filter name="filter_by_draft" string="Draft"
                        domain="[('state', '=', 'draft')]" />

                    <filter name="filter_by_booked" string="Booked"
                        domain="[('state', '=', 'booked')]" />

                    <filter name="filter_by_cancelled" string="Cancelled"
                        domain="[('state', '=', 'cancelled')]" />

                    <!-- group_by -->
                    <!-- <filter name="department" string="Department"
                        context="{'group_by':'name'}" /> -->
                </search>
            </field>
        </record>


        <record id="action_booking_forms" model="ir.actions.act_window">
            <field name="name">Booking Forms</field>
            <field name="res_model">booking.forms</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Booking Forms
                </p>
            </field>
            <field name="context">
                {'search_default_filter_by_booked': 1}
            </field>
        </record>

        <menuitem id="bus_booking" name="Bus Booking" />

        <menuitem id="booking_forms" name="Booking Reservation"
            parent="bus_booking"
            action="action_booking_forms" />
    </data>
</odoo>
