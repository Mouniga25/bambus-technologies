from datetime import timedelta

from odoo import fields
from odoo.tests.common import TransactionCase, tagged


@tagged("post_install", "-at_install")
class TestReceiptEvidence(TransactionCase):
    @classmethod
    def setUpClass(cls):
        super().setUpClass()
        cls.vendor = cls.env["res.partner"].create({"name": "Vendor R"})
        cls.product = cls.env["product.product"].create(
            {"name": "Widget R", "is_storable": True}
        )

    def _po(self, qty=100):
        po = self.env["purchase.order"].create(
            {
                "partner_id": self.vendor.id,
                "order_line": [
                    (0, 0, {
                        "product_id": self.product.id,
                        "product_qty": qty,
                        "price_unit": 1.0,
                        "date_planned": fields.Datetime.now() + timedelta(days=5),
                    })
                ],
            }
        )
        po.button_confirm()
        return po

    def _receive(self, po, qty):
        picking = po.picking_ids.filtered(lambda p: p.state != "done")[:1]
        picking.move_ids.quantity = qty
        picking.with_context(skip_backorder=True).button_validate()
        return picking

    def test_partial_receipt_evidence(self):  # T03 base
        po = self._po(100)
        self._receive(po, 60)
        line = po.order_line
        ev = line._vdi_receipt_evidence()[line.id]
        self.assertEqual(len(ev["tranches"]), 1)
        self.assertEqual(ev["tranches"][0]["net"], 60)
        self.assertFalse(ev["issues"])

    def test_no_receipt_no_tranche(self):
        po = self._po(10)
        line = po.order_line
        ev = line._vdi_receipt_evidence()[line.id]
        self.assertEqual(ev["tranches"], [])