<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Form View -->
        <record id="view_student_fees_form" model="ir.ui.view">
            <field name="name">student.fees.form</field>
            <field name="model">student.fees</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>

                        <h1>
                            <field name="fees_sequence"/>
                        </h1>

                        <group>
                            <group>
                                <field name="student_id"/>
                                <field name="semester"/>
                                <field name="department_id"/>
                            </group>

                            <group>
                                <field name="date_of_payment"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Fees Details">

                                <group>
                                    <group>
                                        <field name="tuition_fee"/>
                                        <field name="examination_fee"/>
                                        <field name="bus_fee"/>
                                    </group>

                                    <group>
                                        <field name="hostel_fee"/>
                                        <field name="mess_fee"/>
                                        <field name="total_fee"
                                               readonly="1"/>
                                    </group>
                                </group>

                            </page>
                        </notebook>

                    </sheet>
                </form>
            </field>
        </record>

        <!-- List View -->
        <record id="view_student_fees_list" model="ir.ui.view">
            <field name="name">student.fees.list</field>
            <field name="model">student.fees</field>
            <field name="arch" type="xml">
                <list>
                    <field name="fees_sequence"/>
                    <field name="student_id"/>
                    <field name="semester"/>
                    <field name="department_id"/>
                    <field name="date_of_payment"/>
                    <field name="total_fee"/>
                </list>
            </field>
        </record>

        <!-- Action -->
        <record id="action_student_fees" model="ir.actions.act_window">
            <field name="name">Student Fees</field>
            <field name="res_model">student.fees</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create Student Fees
                </p>
            </field>
        </record>

        <!-- Menu -->
        <menuitem
            id="student_fees"
            name="Student Fees"
            parent="Configurations_information"
            action="action_student_fees"/>

    </data>
</odoo>