<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_degree_information_kanban" model="ir.ui.view">
            <field name="name">degree.information.kanban</field>
            <field name="model">degree.information</field>
            <field name="arch" type="xml">
                <kanban>
                    <templates>
                        <t t-name="card">
                            <div>
                                <strong> Degree Name: </strong>
                                <field name="name" />
                            </div>

                            <div> Degree code: <field name="degree_code" />
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <record id="view_degree_information_form" model="ir.ui.view">
            <field name="name">degree.information.form</field>
            <field name="model">degree.information</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_click"
                            string="Open Popup"
                            type="object"
                            class="btn-primary" />
                    </header>
                    <sheet>
                        <div class="title" />

                        <h1>
                            <field name="name" placeholder="Degree Name" />
                            <field name="degree_code" placeholder="Degree Code" />
                        </h1>
                        <group>
                        </group>
                        <!-- <notebook>
                            <page string="Degree">
                                <field name="degree_lines">
                                    <list editable="top">
                                        <field name="degree_name" />
                                        <field name="code" />
                                        <field name="phone" />
                                        <button name="action_click"
                                            class="btn-primary"
                                            string="Click"
                                            type="object" />
                                    </list>
                                </field>
                            </page>
                        </notebook> -->
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_degree_information_list" model="ir.ui.view">
            <field name="name">degree.information.list</field>
            <field name="model">degree.information</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" />
                    <field name="degree_code" />
                </list>
            </field>
        </record>
        <record id="action_degree_information" model="ir.actions.act_window">
            <field name="name">Degree Information</field>
            <field name="res_model">degree.information</field>
            <field name="view_mode">kanban,form,list</field>

            <field name="target">current</field>

            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Degree Information
                </p>
            </field>
        </record>
        <menuitem
            id="degree_information"
            name="Degree Information"
            parent="Configurations_information"
            action="action_degree_information" />
    </data>
</odoo>