<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- kanban -->
        <record id="view_student_information_kanban" model="ir.ui.view">
            <field name="name">student.information.kanban</field>
            <field name="model">student.information</field>
            <field name="arch" type="xml">
                <kanban>
                    <templates>
                        <t t-name="card">
                            <div><field name="image" widget="image" /></div>
                            <strong> Name: <field name="name" />
                                  <field name="last_name" />
                            </strong>
                            <div
                                class="rows">
                            </div> 
                            <div> Semester: <field
                                    name="semester" />
                            </div> 
                            <div>
                            Gender: <field name="gender" />
                            </div>
                            <div>
                            DOB: <field name="date_of_birth" />
                            </div>
                            <div>
                            Age: <field name="age" />
                            </div>
                            <div>
                            Department Code :<field name="department_id" />
                            </div>
                            <div>
                            Address: <field name="address" />
                            </div>
                            <div>
                            Email: <field name="email" />
                            </div>
                            <div>
                            Phone:<field name="phone" />
                            </div>
                            <div>
                                 Active <field name="active" />
                            </div>
                            
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <!-- form -->
        <record id="view_student_information_form" model="ir.ui.view">
            <field name="name">student.information.form</field>
            <field name="model">student.information</field>
            <field name="arch" type="xml">
                <form>
                    <header>

                        <button name="action_draft" invisible="state == 'draft'"
                            string="Set to Draft" type="object" />
                        <button name="action_confirm" invisible="state in ['confirm', 'cancel']"
                            string="Set to Confirm" type="object" />
                        <button name="action_cancel" invisible="state == 'cancel'"
                            string="Set to Cancel" type="object" />

                        <!-- <button name="action_draft" invisible="state == 'draft'"
                            string="Set to Draft" type="object" />
                        <button name="action_confirm" invisible="state in ['confirm', 'draft']"
                            string="Set to Confirm" type="object" />
                        <button name="action_cancel" invisible="state in ['confirm', 'cancel']"
                            string="Set to Cancel" type="object" /> -->

                        <field name="state" widget="statusbar" />
                    </header>
                    <sheet>
                        <div class="title" />
                        <field name="image" widget="image" class="oe_avatar" />
                        <h1>
                            <field name="name" placeholder="First Name" />
                            <field name="last_name" placeholder="Last Name" />
                        </h1>
                        <group>
                            <group>

                                <field name="date_of_birth" />
                                <field name="age" readonly='True' />
                                <field name="semester" />
                                <field name="department_id"
                                    placeholder="Select department" />
                                <field name="department_date" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Personal Info">
                                <group>
                                    <field name="address" />
                                    <field name="email" />
                                    <field name="phone" />
                                    <field name="active" />
                                </group>
                            </page>
                            <page string="Guardian Details">
                                <group>
                                    <field name="guardian_name" />
                                    <field name="guardian_relationship" />
                                    <field name="guardian_phone" />
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <!-- list -->
        <record id="view_student_information_list" model="ir.ui.view">
            <field name="name">student.information.list</field>
            <field name="model">student.information</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" />
                    <field name="last_name" />
                    <field name="semester" />
                    <field name="date_of_birth" />
                    <field name="age" />
                    <field name="department_id" />
                    <field name="address" />
                    <field name="email" />
                    <field name="phone" />
                    <field name="active" />
                </list>
            </field>
        </record>

        <!-- search -->
        <record id="view_student_information_search" model="ir.ui.view">
            <field name="name">student.information.search</field>
            <field name="model">student.information</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />
                    <!-- <field name="student_department" /> -->

                    <!-- filter -->
                    <filter name="filter_by_semester_1" string="semester_1"
                        domain="[('semester', '=', 'semester_1')]" />
                    <!-- group_by -->
                    <filter name="department"
                        string="Department"
                        context="{'group_by': 'department_id'}" />
                </search>
            </field>
        </record>
        <record id="action_student_information" model="ir.actions.act_window">
            <field name="name">Student Information</field>
            <field name="res_model">student.information</field>
            <field name="view_mode">kanban,list,form,search</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a student information
                </p>
            </field>
        </record>
        <!-- <menuitem id="student_main_menu" name="College Management System" />
        <menuitem
            id="student_information"
            name="student information"
            parent="student_main_menu"
            action="action_student_information" /> -->


        <menuitem
            id="student_information"
            name="Student Information"
            parent="college_information"
            action="action_student_information" />
    </data>
</odoo>