<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- kanban -->
        <record id="view_department_information_kanban" model="ir.ui.view">
            <field name="name">department.information.kanban</field>
            <field name="model">department.information</field>
            <field name="arch" type="xml">
                <kanban>
                    <templates>
                        <t t-name="card">
                            <strong> Department Name: <field name="name" />
                            </strong>

                            <div>
                                <strong>Department Code: </strong>
                                <field name="department_code" />
                            </div>

                            <div>
                                <strong>Department Date: </strong>
                                <field name="department_date" />
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <!-- form -->
        <record id="view_department_information_form" model="ir.ui.view">
            <field name="name">department.information.form</field>
            <field name="model">department.information</field>
            <field name="arch" type="xml">
                <form>


                    <sheet>
                        <div class="oe_button_box" name="button_box">


                            <button type="object"
                                name="action_view_faculty"
                                class="oe_stat_button"
                                icon="fa-users">

                                <field name="faculty_count" widget="statinfo" />


                            </button>

                            <button type="object"
                                name="action_view_students"
                                class="oe_stat_button"
                                icon="fa-graduation-cap">

                                <field name="student_count" widget="statinfo" />


                            </button>

                        </div>
                        <div class="title" />
                        <h1>
                            <field name="name" placeholder="Department Name" />
                        </h1>
                        <group>
                            <group>
                                <field name="department_date" placeholder="Department Date" />
                                <field name="department_code" placeholder="Department Code" />
                            </group>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>
        <!-- list -->
        <record id="view_department_information_list" model="ir.ui.view">
            <field name="name">department.information.list</field>
            <field name="model">department.information</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" />
                    <field name="department_code" />
                    <field name="department_date" />
                </list>
            </field>
        </record>
        <record id="action_department_information" model="ir.actions.act_window">
            <field name="name">Department Information</field>
            <field name="res_model">department.information</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a department Information
                </p>
            </field>
        </record>
        <menuitem
            id="Configurations_information"
            name="Configurations"
            parent="college_information" />
        <menuitem
            id="department_information"
            name="Department Information"
            parent="Configurations_information"
            action="action_department_information" />
    </data>
</odoo>