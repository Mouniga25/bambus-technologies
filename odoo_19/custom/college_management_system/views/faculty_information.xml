<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_faculty_information_kanban" model="ir.ui.view">
            <field name="name">faculty.information.kanban</field>
            <field name="model">faculty.information</field>
            <field name="arch" type="xml">
                <kanban>
                    <templates>
                        <t t-name="card">
                            <div>
                                <field name="photo" widget="image" class="oe_kanban_image" />
                            </div>
                            <strong>
                                <div> Name : <field name="name" /> <field name="last_name" />
                                </div>
                            </strong>
                            <div
                                class="rows">
                                <div> Age : <field name="age" />
                                </div>
                                <div> Designation : <field name="designation" />
                                </div>

                                <div> DOB : <field name="date_of_birth" />
                                </div>

                                <div> Gender : <field name="gender" />
                                </div>

                                <div> Department : <field name="department_id" />
                                </div>

                                <div> Degree : <field name="degree_ids" />
                                </div>

                                <div> Graduation Institute : <field name="graduation_institute_id" />
                                </div>

                                <div>Address : <field name="address" />
                                </div>

                                <div>Email : <field name="email" />
                                </div>

                                <div>Phone : <field name="phone" />
                                </div>
                                <div> publications: <field name="publications" />
                                </div>
                                <div> total_degrees : <field name="total_degrees" />
                                </div>
                                <!-- Boolean -->
                                <!-- <div> 
                                    <field name="are_you_human" />
                                </div> -->
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>


        <!-- form -->
        <record id="view_faculty_information_form" model="ir.ui.view">
            <field name="name">faculty.information.form</field>
            <field name="model">faculty.information</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>

                        <div class="oe_title">
                            <h1>
                                <field name="sequence" readonly='1' />
                            </h1>

                        </div>
                        <field name="photo" widget="image" class="oe_avatar" />
                        <div class="title" />
                        <h1>
                            <field name="name" placeholder="First Name" />
                            <field name="last_name" placeholder="Last Name" />
                        </h1>
                        <group>
                            <group>
                                <field name="date_of_birth" />
                                <field name="age" readonly='True' />
                                <field name="gender" />
                                <field name="designation" />
                                <field name="department_id"
                                    placeholder="Select Department" />
                                <field name="degree_ids"
                                    widget="many2many_tags"
                                    placeholder="Select Degree" />
                                <field name="graduation_institute_id"
                                    placeholder="Select Graduation Institute" />

                                <!-- <field name="are_you_human" /> -->
                                <field name="total_degrees" />
                                <field name="address" widget="text" />
                                <field name="email" widget="email" />
                                <field name="phone" widget="phone" />
                            </group>
                        </group>
                        <notebook>

                            <page string="Contact Information">
                                <group>
                                    <group>
                                        <field name="address" widget="text" />
                                        <field name="email" widget="email" />
                                        <field name="phone" widget="phone" />
                                    </group>
                                </group>
                            </page>

                            <page string="Other Information">
                                <group>
                                    <group>
                                        <field name="publications" />
                                    </group>
                                </group>
                            </page>

                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>


        <!-- list -->
        <record id="view_faculty_information_list" model="ir.ui.view">
            <field name="name">faculty.information.list</field>
            <field name="model">faculty.information</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" />
                    <field name="last_name" />
                    <field name="date_of_birth" />
                    <field name="age" />
                    <field name="gender" />
                    <field name="designation" />
                    <field name="department_id" />
                    <field name="degree_ids" />
                    <field name="graduation_institute_id" />
                    <field name="address" />
                    <field name="email" />
                    <field name="phone" />
                    <field name="publications" />
                </list>
            </field>
        </record>


        <!-- search -->
        <record id="view_faculty_information_search" model="ir.ui.view">
            <field name="name">faculty.information.search</field>
            <field name="model">faculty.information</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />
                    <!-- <field name="student_department" /> -->

                    <!-- filter -->
                    <filter name="filter_by_male" string="Male"
                        domain="[('gender', '=', 'male')]" />

                    <!-- group_by -->
                    <filter name="department"
                        string="Department"
                        context="{'group_by': 'department_id'}" />
                </search>
            </field>
        </record>
        <record id="action_faculty_information" model="ir.actions.act_window">
            <field name="name">Faculty Information</field>
            <field name="res_model">faculty.information</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a faculty information
                </p>
            </field>
        </record>


        <!-- <menuitem id="faculty_main_menu" name="College Management System" />
        <menuitem
            id="faculty_information"
            name="faculty information"
            parent="faculty_main_menu"
            action="action_faculty_information" /> -->
        <menuitem id="college_information" name="College" />

        <menuitem id="faculty_information" name="Faculty Information"
            parent="college_information"
            action="action_faculty_information" />

    </data>
</odoo>