<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_popup_information_form" model="ir.ui.view">
        <field name="name">popup.information.form</field>
        <field name="model">popup.information</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>  
                        <field name="degree_name" />
                        <field name="code" />
                        <field name="phone" /> 
                        <!-- </list>
                        </field> -->
                    </group>
                </group>
                
            </form>
        </field>
    </record>
    <record id="action_popup_information" model="ir.actions.act_window">
        <field name="name">Popup Information</field>
        <field name="res_model">popup.information</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

